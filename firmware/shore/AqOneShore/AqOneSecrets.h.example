#pragma once

// AqOne Shore Gateway Secrets
// Copy this file to AqOneSecrets.h in this folder and configure values.
// AqOneSecrets.h is gitignored and MUST NEVER be committed.

// Uplink WiFi credentials for the shore gateway
static const char* UPLINK_SSID = "YOUR_WIFI_SSID";
static const char* UPLINK_PASS = "YOUR_WIFI_PASSWORD";

// Ingest API key matching GATEWAY_API_KEY in the backend environment
static const char* GATEWAY_API_KEY = "YOUR_BACKEND_GATEWAY_API_KEY";

// Shared LoRa HMAC authentication key (must match across all mesh nodes).
// Change this before deployment. Never use the published default key.
static constexpr char LOAM_KEY[] = "CHANGE_ME_TO_A_SECURE_RANDOM_KEY";
