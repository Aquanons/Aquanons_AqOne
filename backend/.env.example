DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aqone

# Signs dashboard session tokens. If unset the service still boots, but uses an
# ephemeral secret and every restart logs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Session lifetime in hours. Defaults to 12.
JWT_EXPIRY_HOURS=12

# Required to create dashboard accounts via /api/admin-signup. Leave unset and
# account creation is disabled entirely (the endpoint returns 503). Generate
# one the same way as JWT_SECRET.
ADMIN_SETUP_KEY=

# Guards POST /api/ai/squall/train. Leave unset during a demo.
ALLOW_TRAINING=

# Lets a live squall detection reach level "return_now" (a handset alarm),
# instead of being capped at "watch". Must stay unset until a named MDRRMO
# approver has signed off a recorded field-validation set
# (docs/39_SQUALL_NOWCASTING_IMPLEMENTATION_PLAN.md Phase 4). Never affects
# the synthetic demo route, which always may reach return_now.
SQUALL_RETURN_NOW_ENABLED=

# Registers the presenter-controlled demo routes. Leave unset in production.
DEMO_MODE=

# Header value required by /api/demo/* routes when DEMO_MODE is enabled.
DEMO_CONTROL_KEY=

# Required X-Api-Key value for every gateway-only route: trip contacts,
# pressure and current ingest, advisory delivery receipts, GET /api/sos/downlink
# and GET /api/mesh/chat (docs/04_INGEST_API.md). The shore gateway reads the
# same value from firmware/shore/AqOneShore/AqOneSecrets.h. Leave unset to
# reject every submission - there is no bypass, unlike the always-open SOS
# ingest path.
GATEWAY_API_KEY=

# SMS escalation of an unanswered SOS through Semaphore (app/notify.py). With
# either of the first two unset the scheduler still runs and audits each
# escalation, and the dashboard shows "SMS escalation not configured".
SEMAPHORE_API_KEY=
# Comma-separated on-call numbers.
ONCALL_SMS_NUMBERS=
# Optional registered sender name.
SEMAPHORE_SENDER_NAME=

# Expiry of the free-tier Render database in ISO 8601, shown as days left
# on /api/ops/status. See docs/runbooks/RENDER_FREE_DB_ROTATION.md.
DB_EXPIRES_AT=
