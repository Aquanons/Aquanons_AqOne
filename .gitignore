# Python / backend
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Flutter / mobile
mobile/.dart_tool/

# Written by `flutter gen-l10n` on every build: the list of ARB keys each
# locale is still missing. Useful locally, meaningless in review.
mobile/lib/l10n/untranslated.json

# Also generated by gen-l10n. Recent Flutter dropped the synthetic
# `package:flutter_gen` and emits these next to the .arb sources instead, so
# they land inside lib/ and have to be ignored explicitly. `flutter pub get`
# recreates them; a fresh clone will not analyze until it has been run.
mobile/lib/l10n/app_localizations.dart
mobile/lib/l10n/app_localizations_*.dart

# Android release signing. key.properties holds the keystore password in
# plain text, and a leaked release key is permanent: Play ties app identity to
# it, so whoever holds it can publish updates Android accepts as ours. The
# keystore itself belongs outside the repo entirely - these patterns are the
# second line of defence, not the first.
mobile/android/key.properties
*.jks
*.keystore

# Database dumps pulled off a device with `adb exec-out run-as ... cat`,
# used for the Phase 5 encryption extraction test. These are copies of a real
# handset's local storage - never commit one, even from a test profile.
mobile/out.db
*.db.dump

mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/app/.gradle/
mobile/ios/Pods/

# Machine-specific: holds absolute SDK paths for whoever generated it.
# Committing this breaks every other teammate's build.
mobile/android/local.properties

# Regenerated by the Flutter tool on every build
mobile/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

