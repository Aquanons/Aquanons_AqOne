app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Per-platform Flutter build scaffolding (Generated.xcconfig,
# flutter_export_environment.sh, .plugin_symlinks, GeneratedPluginRegistrant,
# etc). Regenerated by `flutter pub get`/`flutter build` on every machine,
# contains machine-local absolute paths and symlinks - tracking it produces
# a permanent, meaningless diff on every checkout and was the reason nearly
# every file in this repo showed as "modified" with nothing actually
# changed. ios/macos/linux/windows platform folders should have their own
# .gitignore covering this (see ios/.gitignore etc), this is a catch-all in
# case any of those are ever missing again.
**/Flutter/ephemeral/
**/flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/GeneratedPluginRegistrant.*
**/generated_plugin_registrant.*
**/generated_plugins.cmake

# Generated localization files
/lib/l10n/app_localizations*.dart
